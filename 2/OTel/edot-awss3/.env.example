# Copy to .env and fill in. Used by compose.example.yml.

# Elastic (required for elasticsearch exporter)
ELASTIC_ENDPOINT=https://your-deployment.es.us-central1.gcp.cloud.es.io:443
ELASTIC_API_KEY=

# AWS S3 (required if using awss3 exporter in config)
AWS_REGION=us-east-1
S3_BUCKET=your-otel-bucket
S3_PREFIX=otel
